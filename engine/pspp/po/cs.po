msgstr "Součin argumentů UNIFORM přesahuje velikost paměti."

#: src/language/commands/matrix.c:3361
#, c-format
msgid ""
"The operands of %s must have the same dimensions or one must be a scalar."
msgstr ""
"Operandy %s musí mít stejné rozměry, nebo jeden z nich musí být skalár."

