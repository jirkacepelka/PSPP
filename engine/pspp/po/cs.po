#, c-format
msgid "Function %s argument %zu must be a scalar, not a %zu×%zu matrix."
msgstr "Argument %2$zu funkce %1$s musí být skalár, nikoli matice %3$zu×%4$zu."

#: src/language/commands/matrix.c:3864
#, c-format
msgid "Function %s argument %zu must be a vector, not a %zu×%zu matrix."
msgstr "Argument %2$zu funkce %1$s musí být vektor, nikoli matice %3$zu×%4$zu."

