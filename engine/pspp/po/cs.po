#: src/language/commands/matrix.c:4836 src/language/commands/matrix.c:4918
#, c-format
msgid "Undefined variable %s."
msgstr "Nedefinovaná proměnná %s."

#: src/language/commands/matrix.c:4923
#, c-format
msgid "Cannot index %zu×%zu matrix %s."
msgstr "Matici %zu×%zu %s nelze indexovat."

#: src/language/commands/matrix.c:4932
#, c-format
msgid "Can't use vector indexing on %zu×%zu matrix %s."
msgstr "Na matici %zu×%zu %s nelze použít vektorové indexování."

#: src/language/commands/matrix.c:4966 src/language/commands/matrix.c:4978
#, c-format
msgid ""
"Only an %zu-element vector may be assigned to this %zu-element subvector of "
