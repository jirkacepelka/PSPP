#, c-format
msgid "Argument %zu to matrix function %s must be greater than argument %zu."
msgstr "Argument %zu maticové funkce %s musí být větší než argument %zu."

#: src/language/commands/matrix.c:3927
#, c-format
msgid ""
"Argument %zu to matrix function %s must be less than or equal to argument "
"%zu."
msgstr ""
"Argument %zu maticové funkce %s musí být menší nebo roven argumentu %zu."

#: src/language/commands/matrix.c:3933
#, c-format
msgid "Argument %zu to matrix function %s must be less than argument %zu."
msgstr "Argument %zu maticové funkce %s musí být menší než argument %zu."

#: src/language/commands/matrix.c:3939
#, c-format
msgid "Argument %zu to matrix function %s must not be equal to argument %zu."
msgstr "Argument %zu maticové funkce %s se nesmí rovnat argumentu %zu."

#: src/language/commands/matrix.c:3947 src/language/commands/matrix.c:3954
#: src/language/commands/matrix.c:4002
#, c-format
msgid "Argument %zu is %g."
msgstr "Argument %zu je %g."

#: src/language/commands/matrix.c:3950 src/language/commands/matrix.c:4006
#, c-format
msgid "Row %zu, column %zu of argument %zu is %g."
msgstr "Řádek %zu, sloupec %zu argumentu %zu je %g."

#: src/language/commands/matrix.c:3968
#, c-format
msgid "Argument %zu to matrix function %s must be greater than or equal to %g."
msgstr "Argument %zu maticové funkce %s musí být větší nebo roven %g."

#: src/language/commands/matrix.c:3974
#, c-format
msgid "Argument %zu to matrix function %s must be greater than %g."
msgstr "Argument %zu maticové funkce %s musí být větší než %g."

#: src/language/commands/matrix.c:3980
#, c-format
msgid "Argument %zu to matrix function %s must be less than or equal to %g."
msgstr "Argument %zu maticové funkce %s musí být menší nebo roven %g."

#: src/language/commands/matrix.c:3986
#, c-format
msgid "Argument %zu to matrix function %s must be less than %g."
msgstr "Argument %zu maticové funkce %s musí být menší než %g."

#: src/language/commands/matrix.c:3992
#, c-format
msgid "Argument %zu to matrix function %s must not be equal to %g."
msgstr "Argument %zu maticové funkce %s se nesmí rovnat %g."

