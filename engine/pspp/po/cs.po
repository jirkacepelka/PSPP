#: src/data/data-in.c:787
#, c-format
msgid "Day (%ld) must be between 1 and 31."
msgstr "Den (%ld) musí být mezi 1 a 31."

#: src/data/data-in.c:836
msgid "Delimiter expected between fields in date."
msgstr "Mezi poli data se očekává oddělovač."

#: src/data/data-in.c:910
msgid ""
"Unrecognized month format.  Months may be specified as Arabic or Roman "
"numerals or as at least 3 letters of their English names."
msgstr ""
"Nerozpoznaný formát měsíce. Měsíce lze zadat arabskými nebo římskými "
"číslicemi nebo alespoň 3 písmeny jejich anglického názvu."

#: src/data/data-in.c:937
#, c-format
msgid "Year (%ld) must be between 1582 and 19999."
msgstr "Rok (%ld) musí být mezi 1582 a 19999."

#: src/data/data-in.c:948
#, c-format
msgid "Trailing garbage `%.*s' following date."
msgstr "Nesmyslné znaky `%.*s' za datem."

#: src/data/data-in.c:962
msgid "Julian day must have exactly three digits."
msgstr "Juliánský den musí mít přesně tři číslice."

#: src/data/data-in.c:964
#, c-format
msgid "Julian day (%ld) must be between 1 and 366."
msgstr "Juliánský den (%ld) musí být mezi 1 a 366."

#: src/data/data-in.c:988
#, c-format
msgid "Quarter (%ld) must be between 1 and 4."
msgstr "Čtvrtletí (%ld) musí být mezi 1 a 4."

#: src/data/data-in.c:1009
#, c-format
msgid "Week (%ld) must be between 1 and 53."
msgstr "Týden (%ld) musí být mezi 1 a 53."

#: src/data/data-in.c:1021
msgid "Delimiter expected between fields in time."
msgstr "Mezi poli času se očekává oddělovač."

#: src/data/data-in.c:1041
#, c-format
msgid "Minute (%ld) must be between 0 and 59."
msgstr "Minuta (%ld) musí být mezi 0 a 59."

#: src/data/data-in.c:1079
msgid ""
"Unrecognized weekday name.  At least the first two letters of an English "
"weekday name must be specified."
msgstr ""
"Nerozpoznaný název dne v týdnu. Je nutné zadat alespoň první dvě písmena "
"anglického názvu dne."

#: src/data/data-in.c:1214
#, c-format
msgid "`%c' expected in date field."
msgstr "V poli data se očekává `%c'."

#: src/data/data-out.c:585
#, c-format
