"Lze přiřadit pouze vektor o %zu prvcích do tohoto podvektoru o %zu prvcích z "
"%s."

#: src/language/commands/matrix.c:4970
#, c-format
msgid "The source is an %zu×%zu matrix."
msgstr "Zdrojem je matice %zu×%zu."

#: src/language/commands/matrix.c:4981
#, c-format
msgid "The source vector has %zu element."
msgid_plural "The source vector has %zu elements."
msgstr[0] "Zdrojový vektor má %zu prvek."
msgstr[1] "Zdrojový vektor má %zu prvky."
msgstr[2] "Zdrojový vektor má %zu prvků."

