#! /usr/bin/python3

import re
import sys

state = []
for line in sys.stdin:
    line = line.rstrip('\r\n')
    if line.startswith('*'):
        n = int(line[1:])
        for i in range(n):
            state[1] = "%s" % (int(state[1]) + 1)
            state[3] = ' ' + state[3]
            print(' ' + ''.join(state))
    elif line.startswith('$'):
        for c in line[1:]:
            state[1] = "%s" % (int(state[1]) + 1)
            state[4] += c
            print(' ' + ''.join(state))
    elif line.startswith('^'):
        for c in line[1:]:
            state[1] = "%s" % (int(state[1]) + 1)
            state[4] = c + state[4]
            print(' ' + ''.join(state))
    else:
        m = re.match(r'^([A-Z]+)(\d+)([^"]+")( *)([^%"]*)(%?")$', line)
        if m:
            state = list(m.groups())
        print(' ' + line)
