{
  "name": "pspp-studio-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-or-later",
  "description": "MCP server that lets AI agents load data and run PSPP analyses locally (PSPP 2.1.3 compiled to WebAssembly).",
  "bin": { "pspp-studio-mcp": "dist/index.mjs" },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/index.mjs --external:jsdom --banner:js=\"#!/usr/bin/env node\"",
    "typecheck": "tsc --noEmit",
    "test": "node test/smoke.mjs && node test/account.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.0"
  },
  "optionalDependencies": {
    "jsdom": "^25.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  }
}
